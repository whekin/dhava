# OS
.DS_Store

# The project command runner is intentionally tracked even if a developer's
# global Git ignore excludes justfiles.
!justfile

# IDE
.idea/
.vscode/
*.iml

# Env / secrets
.env
.env.*
!.env.example
# Firebase Admin private keys (the Android google-services.json is public config).
firebase-service-account*.json
*firebase-adminsdk*.json

# Claude Code local
.claude/settings.local.json
