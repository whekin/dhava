<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions for ride recording (:core:recording):
        - ACCESS_FINE_LOCATION: GPS traces of downhill runs
        - FOREGROUND_SERVICE(_LOCATION): keep recording with the screen off
        - POST_NOTIFICATIONS: persistent "recording in progress" notification (API 33+)
        - INTERNET: raw recording upload to the backend
        - WAKE_LOCK: partial wake lock while recording; a foreground service
          alone did not stop an OEM power manager from killing the app
          mid-ride (2026-07 OnePlus "o-kill" incident)
        - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: one-time prompt asking the
          user to exempt Dhava from aggressive battery managers (same incident)
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Optional but strongly recommended: lets Android restart the location
         foreground service after an OEM process kill while the screen/app is
         backgrounded. A normal user-started ride still works without it. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        usesCleartextTraffic: dev only — the default upload target is a plain
        HTTP backend on the host machine (10.0.2.2). Remove once a real
        backend URL with TLS is configured.
    -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dhava">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Dhava">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
