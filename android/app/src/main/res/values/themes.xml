<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window-level theme only; all real theming happens in Compose
        (NakvaliTheme in :core:ui). Dark parent because dark is the app's
        primary look — avoids a white flash before Compose attaches.
    -->
    <style name="Theme.Nakvali" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
