<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Recording subscribes to location updates itself, so the requirement is
        declared where it is used rather than relying on a consumer happening to
        declare it. The app already requests this permission, so this adds no
        new capability.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Segment gate haptics. The rider feels a run start and finish through a
        pocket; this is a direct vibration, never an extra notification.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Android's own activity recognition. Optional: it is only used to decide
        sampling rates in a vehicle, and the recorder works unchanged without
        it. Declared where it is used.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application>
        <!--
            Foreground service that records GPS + IMU + barometer while a ride
            is in progress. The "location" type is mandatory on API 34+ for
            services that receive location updates in the background.
        -->
        <service
            android:name="com.nakvali.core.recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
