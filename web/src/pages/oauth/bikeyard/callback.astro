---
import Base from '../../../layouts/Base.astro';
---

<Base
  title="Return to Nakvali"
  description="Return to the Nakvali Android app."
  noindex
>
  <section class="document">
    <p class="eyebrow">NAKVALI + BIKEYARD</p>
    <h1>Back to your ride.</h1>
    <p class="lede">BIKEYARD connection is being prepared.</p>
    <p>
      This is the return address for the Android app. This page does not
      complete a sign-in or upload a ride. When the integration is ready, a
      compatible Nakvali installation will handle this link.
    </p>
    <p>
      If you arrived here from an authorization screen, return to Nakvali. Do
      not copy or share the address from that screen; it may contain a temporary
      authorization code.
    </p>
    <a class="button" href="/">
      Back to Nakvali <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
